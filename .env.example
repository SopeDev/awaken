# LLM avatar decisions (/api/decision)
# Copy to .env.local and fill in (never commit .env.local)
OPENAI_API_KEY=
# Use an id from GET /v1/models for this key; must match Project → Limits "Allowed models"
LLM_MODEL=gpt-4.1-mini
# For gpt-5* / o-series: optional cap (default 4096 in code if unset)
# LLM_MAX_COMPLETION_TOKENS=4096
USE_LOCAL_LLM=false
OLLAMA_HOST=http://127.0.0.1:11434
# Include LLM debug payload in /api/decision response (set false to disable server + browser prompt logs)
LOG_LLM_IO=true
# Optional (client): hide browser-only `[llm] → system/user` logs while keeping LOG_LLM_IO
# VITE_LOG_LLM_PROMPT=false
